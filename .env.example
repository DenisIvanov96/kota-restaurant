# Development template. Copy to .env if you want to override defaults (the app does NOT load
# .env automatically: export the variables or use `node --env-file=.env server/src/server.js`).
# No secrets are required for local development.
# For PRODUCTION use ops/production.env.example (copied to /etc/kota-restaurant/kota.env).
PORT=3000
DATA_DIR=./data
NODE_ENV=development
# COOKIE_SECURE: the Secure cookie flag. Defaults to true when NODE_ENV=production, false otherwise.
# Keep false for http://localhost; must be true anywhere served over HTTPS.
COOKIE_SECURE=false
# TRUST_PROXY: set to 1 only when a reverse proxy (e.g. Caddy) is in front of the app.
TRUST_PROXY=false
# Test hook only (ignored in production): fixed current time, ISO 8601
# KOTA_NOW=2026-06-15T10:00:00Z
# Used only by `npm run admin:create` / `admin:reset-password` (otherwise you are prompted). Never commit a real value.
# ADMIN_PASSWORD=
