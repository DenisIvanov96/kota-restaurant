# Template for the PRODUCTION environment file: /etc/kota-restaurant/kota.env
# Copy to that path (root:kota, mode 0640). Never commit the real file.
# No secrets are needed by the app itself. ADMIN_PASSWORD is NOT stored here; the admin
# CLI takes it from a terminal prompt (preferred) or a one-off environment variable.
NODE_ENV=production
PORT=3000
# Bind address. 127.0.0.1 = reachable only via Caddy on the same host (recommended).
HOST=127.0.0.1
# Public address of the site, used in link previews (Facebook/Viber/WhatsApp). No trailing slash.
SITE_URL=https://kota.example.com
# Absolute path on persistent storage (the folder that will hold kota.db and uploads/)
DATA_DIR=/var/lib/kota-restaurant/data
# Session cookie gets the Secure flag. Keep true whenever the site is served over HTTPS.
COOKIE_SECURE=true
# One reverse proxy (Caddy) in front of the app. Makes rate limiting use real client IPs.
TRUST_PROXY=1
# Do NOT set KOTA_NOW in production (it is ignored there anyway).
