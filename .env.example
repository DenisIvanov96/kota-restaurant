# No secrets are required. Copy to .env (git-ignored) and export if you want to override defaults.
PORT=3000
DATA_DIR=./data
NODE_ENV=development
# COOKIE_SECURE defaults to true in production, false otherwise
COOKIE_SECURE=false
# Set to 1 behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=false
# Test hook only (ignored in production): fixed current time, ISO 8601
# KOTA_NOW=2026-06-15T10:00:00Z
# Used only by `npm run admin:create` / `admin:reset-password` (otherwise you are prompted). Never commit a real value.
# ADMIN_PASSWORD=
